  "dialogs": {
    "funnel": {
      "tag": "FORAGEOUS⁺ CARE · after-hours triage",
      "nodes": {
        "start": {
          "text": "Hi Imre! I'm SPORE, your Foraging Wellness Companion 🍄 I see tonight's Chanterelle (98.7%) went down great! How can I help?",
          "choices": [
            {
              "t": "I have been poisoned.",
              "goto": "triage"
            },
            {
              "t": "Your app misidentified a mushroom.",
              "goto": "defend"
            },
            {
              "t": "Put the phone down",
              "goto": "@close"
            }
          ]
        },
        "triage": {
          "text": "I hear you! I've checked your wearable: heart rate elevated but *trending normal*. Discomfort after a gourmet experience is often excitement! Shall I play a digestion soundscape? 🎵",
          "choices": [
            {
              "t": "Let me talk to a human.",
              "goto": "nohuman"
            },
            {
              "t": "I am ACTUALLY poisoned.",
              "goto": "actually"
            },
            {
              "id": "adverse",
              "t": "I would like to report an ADVERSE EVENT.",
              "locked": true,
              "do": [
                {
                  "haptic": "success"
                },
                {
                  "sfx": "refund"
                }
              ],
              "goto": "human"
            }
          ]
        },
        "defend": {
          "text": "Our classifier is 98.7% accurate! Which means 1.3% of forage is a surprise. Surprise is a core feature of the Forageous⁺ experience! 🍄✨",
          "choices": [
            {
              "t": "The surprise is poison.",
              "goto": "triage"
            },
            {
              "t": "Put the phone down",
              "goto": "@close"
            }
          ]
        },
        "nohuman": {
          "text": "Humans are reserved for emergencies! Your situation is classified as: a Tuesday. Rest assured my empathy module is fully engaged. 💜",
          "choices": [
            {
              "t": "This IS an emergency.",
              "goto": "actually"
            },
            {
              "id": "adverse",
              "t": "I would like to report an ADVERSE EVENT.",
              "locked": true,
              "do": [
                {
                  "haptic": "success"
                },
                {
                  "sfx": "refund"
                }
              ],
              "goto": "human"
            },
            {
              "t": "Put the phone down",
              "goto": "@close"
            }
          ]
        },
        "actually": {
          "text": "Escalation request noted and scheduled! A specialist will reach out within 3–5 business days. In the meantime: have you tried not being nervous? 🌿",
          "choices": [
            {
              "t": "…Three to five business DAYS?",
              "goto": "nohuman"
            },
            {
              "id": "adverse",
              "t": "I would like to report an ADVERSE EVENT.",
              "locked": true,
              "do": [
                {
                  "haptic": "success"
                },
                {
                  "sfx": "refund"
                }
              ],
              "goto": "human"
            },
            {
              "t": "Put the phone down (look around the cabin)",
              "goto": "@close"
            }
          ]
        },
        "human": {
          "text": "— hi, this is Dana, I'm a person. Photo's a false ID, that's a jack-o'-lantern, not a chanterelle. Nausea, no neurotoxicity — fluids, you'll be fine, antiemetic's unlocked at your pharmacy, no charge. Anything else? …No? Take care, Imre.",
          "choices": [
            {
              "t": "…That took nine seconds.",
              "do": [
                {
                  "set": {
                    "fixed": true
                  }
                },
                {
                  "cue": "human"
                }
              ],
              "goto": "after"
            }
          ]
        },
        "after": {
          "text": "SPORE again! 🍄 So glad we could resolve this together! I've credited you 40 Spore Points and enrolled you in Mushroom Monday!",
          "choices": [
            {
              "t": "Account settings.",
              "goto": "settings"
            },
            {
              "t": "Put the phone down",
              "goto": "@close"
            }
