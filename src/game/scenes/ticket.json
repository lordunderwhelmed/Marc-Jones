  "dialogs": {
    "appeal": {
      "tag": "GRIM-77 · CIVIC COMPLIANCE APPEAL",
      "nodes": {
        "start": {
          "text": "CITIZEN. Citation #7742-K issued for: PARKING (you). Vehicle XK-55-TR matched at 91% confidence. How do you plead?",
          "choices": [
            {
              "t": "I don't even own a car.",
              "goto": "nocar"
            },
            {
              "t": "You matched my JACKET.",
              "goto": "jacket"
            },
            {
              "id": "plate",
              "t": "The real XK-55-TR is right across the street.",
              "locked": true,
              "goto": "plate1"
            },
            {
              "id": "lens",
              "t": "Your lens is wearing garlic sauce.",
              "locked": true,
              "goto": "lens1"
            },
            {
              "t": "Step away from the robot",
              "goto": "@close"
            }
          ]
        },
        "nocar": {
          "text": "NOTED. Citation amended: PARKING WITHOUT A VEHICLE. Fine unchanged. Thank you for your honesty.",
          "choices": [
            {
              "t": "That's worse. You made it worse.",
              "goto": "start"
            }
          ]
        },
        "jacket": {
          "text": "GARMENT-BASED IDENTIFICATION IS COURT-TESTED. THE COURT WAS ALSO A UNIT.",
          "choices": [
            {
              "t": "…Of course it was.",
              "goto": "start"
            }
          ]
        },
        "plate1": {
          "text": "SCANNING… VEHICLE LOCATED. ANOMALY: TWO (2) XK-55-TR IN SECTOR. PLEASE STOP BEING THE SECOND ONE.",
          "choices": [
            {
              "id": "lens",
              "t": "Check your lens. It's wearing dinner.",
              "locked": true,
              "goto": "verdict"
            },
            {
              "t": "I am a JACKET, not a car.",
              "goto": "start"
            }
          ]
        },
        "lens1": {
          "text": "DIAGNOSTIC… VISIBILITY: 34%. FLAVOR PROFILE: ROBUST. THIS DOES NOT AFFECT CONFIDENCE.",
          "choices": [
            {
              "id": "plate",
              "t": "At 34% visibility, scan the REAL plate. Across the street.",
              "locked": true,
              "goto": "verdict"
            },
            {
              "t": "How does flavor not affect confidence?!",
              "goto": "start"
            }
          ]
        },
        "verdict": {
          "text": "RECALCULATING… APPEAL ACCEPTED. CITATION #7742-K: VOIDED. RECALIBRATING… NEW CITATION #7743-K ISSUED TO: XK-55-TR (VEHICLE, HYDRANT-ADJACENT). JUSTICE: RESTORED.",
          "choices": [
            {
              "t": "That's Mrs. Adamec's nephew's car.",
              "goto": "ada"
            }
          ]
        },
        "ada": {
          "text": "ADDITIONAL: MOVEMENT DETECTED IN WINDOW 4B. RESIDENT HAS OPENED: CIVSHIELD APP. RESIDENT HAS SELECTED: ACCOUNT SETTINGS. THIS UNIT EXPERIENCES: NO FEELINGS ABOUT THIS.",
          "choices": [
            {
              "t": "Open CivShield. Account settings.",
              "goto": "confirm"
            }
          ]
        },
        "confirm": {
          "text": "CIVSHIELD: Closing your account forfeits 12 Compliance Stars and your Good Standing (currently: cited). Are you sure?",
          "choices": [
            {
              "t": "TERMINATE. AND TELL THE COURT-UNIT I SAID HI.",
              "do": [
                {
                  "set": {
                    "terminated": true
                  }
                },
                {
                  "haptic": "terminate"
                },
                {
                  "sfx": "terminate"
                },
                {
                  "cue": "terminate"
                },
                {
                  "end": {
                    "counter": "4",
                    "line": "02:31. Citation voided. Above the street, Ada's window went dark — then her account did too. Two more of 555,789."
                  }
                }
              ],
              "goto": "@close"
            }
          ]
        }
      }
    }
